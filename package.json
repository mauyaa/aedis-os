{
  "name": "aedis-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:no-credit": "node scripts/no-credit-gate.mjs",
    "test:live": "node scripts/openai-live-smoke.mjs",
    "test:production": "node scripts/live-smoke.mjs",
    "eval": "vitest run evals",
    "security:scan": "node scripts/scan-client-secrets.mjs",
    "audit:ci": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.25.0",
    "next": "16.4.1",
    "openai": "^6.48.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.31",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.31",
      "sharp@<0.35.5": "0.35.5",
      "nanoid@<3.3.18": "3.3.18",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
